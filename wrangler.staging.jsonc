{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orderflow-korea-upgrade-staging",
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "assets": {
    "directory": "./dist/client"
  },
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orderflow-upgrade-staging-db",
      "database_id": "041d4c40-6cd0-4e42-9355-007008caeec4",
      "migrations_dir": "./drizzle"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
