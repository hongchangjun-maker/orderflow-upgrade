{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orderflow-korea-upgrade",
  "main": "./worker/index.ts",
  "assets":{"binding":"ASSETS"},
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orderflow-upgrade-db",
      "database_id": "57726ecb-0172-4cf3-a90a-fea88db1de50",
      "migrations_dir": "./drizzle"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_TEST_ENTRY":"1"
  },
  "r2_buckets": [{"binding":"LIVE_MEDIA","bucket_name":"orderflow-upgrade-media"}],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.02
    }
  }
}
